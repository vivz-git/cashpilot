# Public URL the site is served from. Used for canonical, Open Graph and sitemap URLs.
NEXT_PUBLIC_SITE_URL=https://cashpilot.example.com

# Optional. When set, the early access form POSTs JSON to this URL
# (e.g. a Formspree endpoint, a webhook, or a future CashPilot API route).
# When unset, submissions are only kept in the visitor's browser and
# the form says so.
NEXT_PUBLIC_EARLY_ACCESS_ENDPOINT=
