# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://cashpilot:cashpilot_dev@localhost:5432/cashpilot_dev
# Used only by the automated test suite (integration + e2e). Must be a separate DB.
TEST_DATABASE_URL=postgres://cashpilot:cashpilot_dev@localhost:5432/cashpilot_test

# --- App ------------------------------------------------------------------
# Public base URL of the app (used for cookie security decisions).
APP_URL=http://localhost:3000

# --- AI -------------------------------------------------------------------
# "groq" for real analysis, "mock" for deterministic offline rules (default).
AI_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Email ----------------------------------------------------------------
# "mock" records emails in memory and never sends them (default).
# "smtp" sends through an authenticated SMTP server.
EMAIL_PROVIDER=mock
EMAIL_FROM="Accounts Receivable <billing@example.com>"
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (port 465). STARTTLS is required otherwise.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
